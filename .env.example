# Copy to .env and fill in. Never commit .env.

# --- App ---
# ENV=dev                 # dev shows /docs; anything else hides them
# DEBUG=false

# --- Valhalla ---
# VALHALLA_URL=http://localhost:8002
# VALHALLA_ELEVATION_DIR=./valhalla/elevation

# --- Database ---
# DB_DRIVER=postgresql+asyncpg
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=cycling
# DB_PASSWORD=cycling
# DB_NAME=cycling_router

# --- Auth ---
# JWT_SECRET_KEY=change-me-to-a-32+-byte-random-string
# AUTH_REDIRECT_BASE=http://localhost:8000

# --- OAuth provider (minimum scope: google openid+email) ---
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# --- Email (Brevo transactional API; console logging when the key is absent) ---
# BREVO_API_KEY=
# MAIL_FROM=no-reply@yourdomain.com
# BREVO_LIST_ID=

# --- Verification codes (six digit OTP) ---
# OTP_EXPIRE_MINUTES=15
# OTP_MAX_ATTEMPTS=5

# --- Rate limiting (per-endpoint budgets live in app/core/ratelimit.py) ---
# RATE_LIMIT_ENABLED=true

# --- CORS ---
# CORS_ORIGINS=["*"]

# Show full request/response bodies inline (raw always saved to output/)
# VERBOSE=0
