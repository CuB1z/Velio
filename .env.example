# API base. Relative in development so the Vite proxy (vite.config.ts)
# forwards it to http://127.0.0.1:8000 without CORS.
VITE_API_BASE_URL=/api/v1

# Production (Dockerfile, see docs/deploy.md) keeps the same relative base:
# nginx serves the SPA and proxies /api on the same origin. Only the nginx
# upstream changes, set as a runtime env var on the container:
# API_UPSTREAM=http://velio-api:8000
