# Copy to .env and fill in. Never commit .env.

# --- App ---
# ENV=dev                 # dev shows /docs; anything else hides them
# DEBUG=false

# --- Valhalla ---
# VALHALLA_URL=http://localhost:8002
# VALHALLA_ELEVATION_DIR=./valhalla/elevation
# RESTRICTED_AREAS_PATH=data/restricted_areas.geojson   # python -m tools.extract_restricted_areas
# COVERAGE_PATH=data/coverage.geojson                   # python -m tools.build_coverage

# --- Database ---
# DB_DRIVER=postgresql+asyncpg
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=cycling
# DB_PASSWORD=cycling
# DB_NAME=cycling_router

# --- Auth ---
# JWT_SECRET_KEY=change-me-to-a-32+-byte-random-string
# AUTH_REDIRECT_BASE=http://localhost:8000

# --- OAuth provider (minimum scope: google openid+email) ---
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# --- Email (Brevo transactional API; console logging when the key is absent) ---
# BREVO_API_KEY=
# MAIL_FROM=no-reply@yourdomain.com
# SITE_URL=https://velio.cub1z.es   # logo and links in emails
# BREVO_LIST_ID=

# --- Verification codes (six digit OTP) ---
# OTP_EXPIRE_MINUTES=15
# OTP_MAX_ATTEMPTS=5
# OTP_TEST_MODE=false   # requires ENV=dev too; no emails sent, any code verifies. NEVER in production.

# --- Containerised stack (docker/docker-compose.yaml) ----------------------
# Required keys when launching with --env-file; hostnames are the compose
# service names.
# ENV=dev
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_BACKEND=memory          # or redis
# REDIS_URL=redis://redis:6379/0
# VALHALLA_URL=http://valhalla-router:8002

# --- Production compose (docker/docker-compose.dokploy.yaml, set in Dokploy) ---
# VELIO_TAG=latest                   # image tag to run
# VALHALLA_DIR=/srv/velio/valhalla   # host folder with config/, tiles.tar and elevation/
# VALHALLA_THREADS=2                 # match the vCPUs
# UVICORN_WORKERS=1

# --- Database backups (db-backup in docker/docker-compose.dokploy.yaml) ---
# BACKUP_PASSPHRASE=                 # GPG passphrase; keep a copy off the server, dumps are unreadable without it
# BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# BACKUP_S3_REGION=eu-central-003
# BACKUP_S3_BUCKET=velio-backups
# BACKUP_S3_ACCESS_KEY_ID=           # B2 application key scoped to the bucket, read and write
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=velio/prod
# BACKUP_SCHEDULE=@daily
# BACKUP_KEEP_DAYS=14

# --- Rate limiting (per-endpoint budgets live in app/core/ratelimit.py) ---
# RATE_LIMIT_ENABLED=true

# --- CORS ---
# CORS_ORIGINS=["*"]

# --- Metrics (GET /metrics, closed by default) ---
# METRICS_ENABLED=false
# METRICS_TOKEN=

# Show full request/response bodies inline (raw always saved to output/)
# VERBOSE=0
